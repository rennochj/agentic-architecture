        <mxCell id="q1" value="1. MAP: What is the primary goal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#14b8a6;fontColor=#ffffff;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a1_a" value="Synthesize/Generate Content&#xa;→ Group A Archetypes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#e2e8f0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a1_b" value="Provide Insight / Decision Support&#xa;→ Group B Archetypes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#e2e8f0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="360" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a1_c" value="Automate a Process / Task&#xa;→ Group C Archetypes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#e2e8f0;fontSize=12;" vertex="1" parent="1">
