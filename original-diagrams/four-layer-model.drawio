  <diagram id="four-layer-model" name="Four-Layer-Model">
    <mxGraphModel grid="0" page="0" pageWidth="700" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Layer 1: Use Case Archetypes -->
        <mxCell id="L1" value="&lt;b style='font-size:15px'&gt;Layer 1 · Use Case Archetypes&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;What job needs to be done?&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:10px;opacity:0.8'&gt;13 archetypes · 3 value groups · 4 Architectural Dimensions&lt;/span&gt;"
