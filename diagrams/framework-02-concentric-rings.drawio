                <mxCell id="comp_title" value="ARCHETYPE COMPOSITION" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#c7d2fe;fontSize=11;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1195" y="1448" width="200" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="comp_text" value="Solutions can span multiple archetypes:&#xa;  • Sequential — output feeds next stage&#xa;  • Parallel — concurrent over same context&#xa;  • Nested — outer delegates to inner&#xa;Union features, tier to highest, govern to strictest." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e2e8f0;fontSize=10;align=left;spacing=4;" parent="1" vertex="1">
