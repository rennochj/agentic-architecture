                <mxCell id="guide_title" value="HOW TO READ" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#fbbf24;fontSize=11;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1195" y="1288" width="150" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="guide_text" value="Read outside → in:&#xa;  1. Pick your Archetype (outer ring)&#xa;  2. Identify required Features (next ring)&#xa;  3. Select Components (next ring)&#xa;  4. Choose a Platform (center)&#xa;Cross-cutting: Tiers T1–T4 apply at every ring.&#xa;★ = Required by all archetypes in production." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e2e8f0;fontSize=10;align=left;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="1195" y="1308" width="350" height="100" as="geometry"/>
