                <mxCell id="comp_rules" value="Rules: ① Union features  ② Highest tier governs  ③ Interface contracts at seams  ④ Strictest governance  ⑤ End-to-end eval" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#fbbf24;fontSize=10;fontStyle=1;align=left;" parent="1" vertex="1">
