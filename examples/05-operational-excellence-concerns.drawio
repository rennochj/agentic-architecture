                <!-- §5.5 Cost Management -->
                <mxCell id="s55" value="§5.5 Cost Management&#xa;&amp; Budget Controls&#xa;══════════════════&#xa;• Per-agent cost ceilings&#xa;• Workflow budget caps&#xa;• Cost-based circuit breakers&#xa;• Model routing (cheap→expensive)&#xa;• Cascade patterns&#xa;• Spend observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;strokeWidth=2;" parent="1" vertex="1">
