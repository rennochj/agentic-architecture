                <!-- §5.10 Identity & Access -->
                <mxCell id="s510" value="§5.10 Identity, Access&#xa;&amp; Authorization&#xa;══════════════════&#xa;• Role-based model access&#xa;• Agent authorization scopes&#xa;• Least privilege for agents&#xa;• Credential vaulting&#xa;• Multi-tenant isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;strokeWidth=2;" parent="1" vertex="1">
