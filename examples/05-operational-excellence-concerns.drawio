<mxfile host="app.diagrams.net">
    <diagram name="Operational Excellence — Cross-Cutting Concerns" id="ops-excellence-wheel">
        <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- Background -->
                <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0b1220;gradientColor=#111b34;gradientDirection=south;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry width="1600" height="1300" as="geometry"/>
                </mxCell>

                <!-- Title -->
                <mxCell id="title" value="Operational Excellence — 11 Cross-Cutting Concerns" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e2e8f0;fontSize=26;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="§5 Operational Excellence: Every production GenAI system requires these capabilities regardless of tier (T1–T4)" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#94a3b8;fontSize=13;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="900" height="22" as="geometry"/>
                </mxCell>

                <!-- ═══════ CENTRAL HUB ═══════ -->
                <mxCell id="hub" value="PRODUCTION&#xa;GenAI&#xa;SYSTEM" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#fbbf24;fontColor=#fbbf24;fontSize=16;fontStyle=1;shadow=1;strokeWidth=3;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="670" y="440" width="160" height="160" as="geometry"/>
                </mxCell>

                <!-- ═══════ SAFETY GROUP (Top-Left) — Pre-Production Gates ═══════ -->
                <mxCell id="grp_safety_label" value="PRE-PRODUCTION GATES" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#fbbf24;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="100" width="200" height="20" as="geometry"/>
                </mxCell>

                <!-- §5.1 Safety -->
                <mxCell id="s51" value="§5.1 Safety, Guardrails&#xa;&amp; Alignment&#xa;══════════════════&#xa;• Input guardrails&#xa;  (injection defense, PII)&#xa;• Output guardrails&#xa;  (moderation, hallucination)&#xa;• Conversational safety&#xa;• Alignment techniques&#xa;• Security controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#f59e0b;fontColor=#fef3c7;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="130" width="230" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="s51_line" value="" style="endArrow=classic;html=1;strokeColor=#f59e0b;strokeWidth=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="280" y="280" as="sourcePoint"/>
                        <mxPoint x="680" y="480" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- §5.2 Evaluation -->
                <mxCell id="s52" value="§5.2 Evaluation &amp; Testing&#xa;══════════════════&#xa;• LLM-as-Judge&#xa;• Human evaluation&#xa;• Golden dataset testing&#xa;• Red teaming (mandatory)&#xa;• Testability by design&#xa;• Eval-as-Code in CI/CD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#f59e0b;fontColor=#fef3c7;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="290" y="130" width="230" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="s52_line" value="" style="endArrow=classic;html=1;strokeColor=#f59e0b;strokeWidth=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="440" y="345" as="sourcePoint"/>
                        <mxPoint x="700" y="460" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- §5.9 Data Readiness -->
                <mxCell id="s59" value="§5.9 Data Readiness &amp;&#xa;Knowledge Governance&#xa;══════════════════&#xa;• Data readiness assessment&#xa;  (8 pre-project checks)&#xa;• Corpus lifecycle management&#xa;• Data quality pipelines&#xa;• PII scrubbing at ingestion&#xa;• Structured data readiness&#xa;• Index &amp; corpus operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#f59e0b;fontColor=#fef3c7;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;strokeWidth=2;" parent="1" vertex="1">
