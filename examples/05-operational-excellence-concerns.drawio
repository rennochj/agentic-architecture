                <!-- §5.11 Incident Response -->
                <mxCell id="s511" value="§5.11 Incident Response&#xa;&amp; AI Ops Runbooks&#xa;══════════════════&#xa;• AI incident classification&#xa;• Kill switches (feature / model)&#xa;• Post-incident analysis&#xa;• Operational playbooks:&#xa;  – Runaway agent&#xa;  – Harmful output&#xa;  – Data leakage&#xa;  – Model drift&#xa;  – Provider outage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#8b5cf6;fontColor=#ddd6fe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;strokeWidth=2;" parent="1" vertex="1">
