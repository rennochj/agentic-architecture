                <mxCell id="c_agent_arch" value="§4.1 Agentic Architectures&#xa;─────────────────────&#xa;• Single-Agent (ReAct, Plan-Execute, Reflexion)&#xa;• Multi-Agent (Supervisor, Hierarchical, Swarm)&#xa;• Agent Frameworks &amp; Protocols" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#ef4444;fontColor=#fecaca;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
