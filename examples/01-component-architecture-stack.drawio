                </mxCell>

                <!-- Title -->
                <mxCell id="title" value="Technical Component Architecture — Four-Layer Stack" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e2e8f0;fontSize=26;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="40" as="geometry"/>
