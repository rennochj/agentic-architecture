                </mxCell>
                <mxCell id="legend_text" value="Each layer builds on the one above. Foundation (T1) is the floor for all solutions. Augmentation (T2) adds retrieval &amp; structured output. Orchestration (T3) adds state, memory, reasoning &amp; tools. Autonomy (T4) adds agentic collaboration &amp; production deployment. Operational Excellence spans all tiers — every production system needs safety, eval, observability, and cost controls regardless of tier." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="175" y="1005" width="1060" height="50" as="geometry"/>
                </mxCell>
            </root>
