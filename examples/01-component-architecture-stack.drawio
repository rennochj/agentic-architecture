                <mxCell id="c_context" value="§3.1 Context Management&#xa;─────────────────────&#xa;• Window Strategies&#xa;• Info Prioritization&#xa;• Multi-Turn &amp; Dialog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1d6e;strokeColor=#8b5cf6;fontColor=#ddd6fe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
