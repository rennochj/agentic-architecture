                <mxCell id="c_models" value="§1.1 Foundation Models&#xa;─────────────────────&#xa;• LLMs, VLMs, Multimodal, Speech&#xa;• Transformer, MoE, SSM&#xa;• Fine-Tuning, Alignment, Distillation&#xa;• Quantization, Speculative Decoding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#a7f3d0;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="205" width="300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="c_prompts" value="§1.2 Prompting Techniques&#xa;─────────────────────&#xa;• Zero/Few-Shot, CoT, ToT&#xa;• ReAct, Reflexion, REWOO&#xa;• Prompt Chaining &amp; Optimization&#xa;• Role &amp; Persona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#a7f3d0;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="495" y="205" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="c_selection" value="§1.3 Model Selection &amp;&#xa;Customization Strategy&#xa;─────────────────────&#xa;• 5 Selection Dimensions&#xa;• Customization Ladder (0–7)&#xa;• Evaluation, Fine-Tuning, Distillation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#a7f3d0;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="205" width="290" height="130" as="geometry"/>
                </mxCell>

                <!-- ═══════════════ AUGMENTATION LAYER (T2) ═══════════════ -->
                <mxCell id="t2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2d48;strokeColor=#2563eb;strokeWidth=2;opacity=70;" parent="1" vertex="1">
                    <mxGeometry x="160" y="370" width="1100" height="180" as="geometry"/>
