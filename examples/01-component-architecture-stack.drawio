                <mxCell id="c_memory" value="§3.2 Memory Systems&#xa;─────────────────────&#xa;• Short-Term / Long-Term&#xa;• Episodic / Semantic / Procedural&#xa;• Shared &amp; Distributed Memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1d6e;strokeColor=#8b5cf6;fontColor=#ddd6fe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
