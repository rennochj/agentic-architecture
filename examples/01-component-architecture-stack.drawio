                <mxCell id="c_hitl" value="§4.3 Human-in-the-Loop&#xa;─────────────────────&#xa;• Approval Workflows&#xa;• Escalation Patterns&#xa;• Live Agent Handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#ef4444;fontColor=#fecaca;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="720" y="805" width="220" height="130" as="geometry"/>
