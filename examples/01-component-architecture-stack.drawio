                <mxCell id="c_runtime" value="§4.4 Agent Runtime&#xa;&amp; Deployment&#xa;─────────────────────&#xa;• Hosting &amp; Session Lifecycle&#xa;• Compute Isolation&#xa;• Managed vs. Self-Hosted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#ef4444;fontColor=#fecaca;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
