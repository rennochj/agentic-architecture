                <mxCell id="subtitle" value="Layer 3 Reference: From Foundation Models to Autonomous Agents, with cross-cutting Operational Excellence" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#94a3b8;fontSize=13;align=left;" parent="1" vertex="1">
