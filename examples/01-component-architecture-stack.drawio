                </mxCell>
                <mxCell id="c_output" value="§2.2 Output Processing &amp; Structured Generation&#xa;──────────────────────────────────────&#xa;• JSON / Code / Structured Data Generation&#xa;• Grammar-Based &amp; Schema-Constrained Output&#xa;• Validation, Repair &amp; Citation&#xa;• Streaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
