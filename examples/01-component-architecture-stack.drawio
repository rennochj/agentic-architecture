                <mxCell id="c_workflow" value="§4.2 Workflow Orchestration&#xa;─────────────────────&#xa;• Sequential / Parallel / Conditional&#xa;• Graph-Based (DAG, Cyclic, State Machine)&#xa;• State Management &amp; Checkpointing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#ef4444;fontColor=#fecaca;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
