                <mxCell id="c_rag" value="§2.1 RAG &amp; Information Retrieval&#xa;──────────────────────────────&#xa;• Basic → Advanced → Agentic → Graph RAG&#xa;• Vector Storage (HNSW, IVF, Hybrid Search)&#xa;• Document Processing &amp; Chunking&#xa;• Knowledge Graph Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=10;align=left;spacing=8;verticalAlign=top;shadow=1;" parent="1" vertex="1">
