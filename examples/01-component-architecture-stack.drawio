                <mxCell id="ui_label" value="USER INTERFACE LAYER" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#94a3b8;fontSize=14;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="160" y="110" width="1100" height="30" as="geometry"/>
                </mxCell>

                <!-- ═══════════════ FOUNDATION LAYER (T1) ═══════════════ -->
                <mxCell id="t1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#052e16;strokeColor=#059669;strokeWidth=2;opacity=70;" parent="1" vertex="1">
                    <mxGeometry x="160" y="170" width="1100" height="180" as="geometry"/>
